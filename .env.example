APP_NAME="DEV ESCCAY TEMPLATE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Accra
APP_URL=https://example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First admin created by `php artisan db:seed` (required outside local/testing).
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
SEED_DEMO_CATALOG=false
# Developer account (template licensing console)
SEED_DEVELOPER_NAME="Template Developer"
SEED_DEVELOPER_EMAIL=
SEED_DEVELOPER_PASSWORD=
SEED_DEVELOPER_PHONE=

# Refer2Bundle data provider (legacy reseller storefront)
REFER2BUNDLE_BASE_URL=https://databosshub.org/api/v1
REFER2BUNDLE_API_KEY=

# Service provider API (data, WAEC, utility, subscriptions, AFA)
PATUPAA_API_BASE_URL=https://patupaa.com/api/v1
PATUPAA_API_KEY=
PATUPAA_API_SECRET=
PATUPAA_API_TIMEOUT=25

# Paystack
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Developer template pushes
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
